# Database Configuration (for Docker)
DATABASE_HOST=postgres
DATABASE_USERNAME=balconcito
DATABASE_PASSWORD=balconcito_dev_password
DATABASE_NAME=balconcito_api_development
DATABASE_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Loyverse API Configuration
# Obtén tu token en: https://r.loyverse.com/dashboard/settings/api
LOYVERSE_API_TOKEN=your_loyverse_api_token_here
LOYVERSE_STORE_ID=your_store_id_here

# JWT Secret (for Devise JWT)
# Genera con: bundle exec rails secret
DEVISE_JWT_SECRET_KEY=change_this_in_production

# Rails Master Key (solo en producción)
# RAILS_MASTER_KEY=

# Rails Environment
RAILS_ENV=development
RACK_ENV=development

# Server Configuration
RAILS_MAX_THREADS=5
PORT=3000

# CORS Configuration (Frontend URL)
FRONTEND_URL=http://localhost:5173

# Webhook Configuration
LOYVERSE_WEBHOOK_SECRET=your_webhook_secret_here
